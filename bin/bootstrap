#!/bin/sh
# Python riêng qua uv; gói khóa hash; kiểm điều kiện trước khi cài.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"
WITH_TTS=0
DOWNLOAD_MODEL=1
for arg in "$@"; do
  case "$arg" in
    --with-tts) WITH_TTS=1 ;;
    --skip-tts-model) DOWNLOAD_MODEL=0 ;;
    *) echo "Cách dùng: bin/bootstrap [--with-tts [--skip-tts-model]]" >&2; exit 1 ;;
  esac
done
for tool in git uv node npm ffmpeg ffprobe; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "Thiếu $tool. Xem phần cài máy mới trong README.md, rồi chạy lại bin/bootstrap." >&2
    exit 1
  }
done
node -e 'if (process.versions.node.split(".")[0] !== "22") { console.error("Cần Node.js 22.x. Dùng nvm install 22 && nvm use 22, rồi chạy lại bin/bootstrap."); process.exit(1); }'
NPM_VERSION="$(npm --version)"
case "$NPM_VERSION" in
  [0-9]*.*) [ "${NPM_VERSION%%.*}" -ge 10 ] || { echo "Cần npm >= 10 (đi kèm Node 22)." >&2; exit 1; } ;;
  *) echo "Không xác định được phiên bản npm." >&2; exit 1 ;;
esac
# Không chọn Python mặc định của máy. uv tự tải 3.12 nếu chưa có.
PY_VERSION="$(cat .python-version)"
ensure_venv() {
  ENV_PATH="$1"
  if [ -e "$ENV_PATH" ] || [ -L "$ENV_PATH" ]; then
    if ! [ -x "$ENV_PATH/bin/python" ] || ! "$ENV_PATH/bin/python" -I -c 'import sys; from pathlib import Path; assert sys.version_info[:2] == (3, 12); assert Path(sys.argv[1], ".news-root").read_text().strip() == str(Path.cwd())' "$ENV_PATH" 2>/dev/null; then
      mkdir -p .cache/venv-backups
      BACKUP="$(mktemp -d .cache/venv-backups/old-XXXXXX)"
      mv "$ENV_PATH" "$BACKUP/venv"
      echo "Đã giữ môi trường cũ tại $BACKUP/venv; tạo lại cho máy này."
    fi
  fi
  [ -x "$ENV_PATH/bin/python" ] || uv venv --python "$PY_VERSION" "$ENV_PATH"
  printf '%s\n' "$ROOT" > "$ENV_PATH/.news-root"
}
ensure_venv .venv
uv pip sync --python .venv/bin/python --require-hashes requirements.lock
printf '%s\n' "$ROOT" > .venv/.news-root
.venv/bin/python -I core/news/runtime.py "$ROOT"
uv pip check --python .venv/bin/python
[ -f config/machine.yaml ] || cp config/machine.example.yaml config/machine.yaml
[ -f .env ] || cp .env.example .env
.venv/bin/python -I core/scripts/install_hooks.py
(cd core/remotion && npm ci --no-audit --no-fund)
(cd core/remotion && ./node_modules/.bin/remotion browser ensure)
.venv/bin/python -I core/scripts/fetch_sfx.py
if [ "$WITH_TTS" = 1 ]; then
  ensure_venv .venv-align
  uv pip sync --python .venv-align/bin/python --require-hashes core/tts/requirements-align.lock
  uv pip check --python .venv-align/bin/python
  [ "$DOWNLOAD_MODEL" = 0 ] || bin/tts model download
fi
echo "Xong. Sửa config/machine.yaml và .env cho máy này, rồi chạy: bin/news doctor"
