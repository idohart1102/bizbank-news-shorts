#!/bin/sh
# Không dùng Python/gói ngoài môi trường riêng của dự án.
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || { echo "Chưa có .venv hợp lệ. Vào thư mục repo rồi chạy: bin/bootstrap" >&2; exit 1; }
"$PY" -I "$ROOT/core/news/runtime.py" "$ROOT" || exit 1
cd "$ROOT"
PYTHONPATH="$ROOT/core" PYTHONNOUSERSITE=1 exec "$PY" -m news.cli "$@"
