{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "brief",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "format",
  "story_ids",
  "angle",
  "hook",
  "points",
  "action",
  "template",
  "sources"
 ],
 "properties": {
  "format": {
   "type": "string",
   "enum": [
    "deep",
    "digest"
   ]
  },
  "story_ids": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "maxItems": 4
  },
  "angle": {
   "type": "string",
   "description": "góc nhìn: ảnh hưởng gì tới túi tiền chủ shop"
  },
  "hook": {
   "type": "string"
  },
  "points": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 2,
   "maxItems": 4
  },
  "action": {
   "type": "string",
   "description": "chủ shop cần làm gì ngay"
  },
  "template": {
   "type": "string",
   "description": "tên mẫu overlay, mặc định default"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "url",
     "publisher",
     "tier"
    ],
    "properties": {
     "url": {
      "type": "string",
      "description": "URL đầy đủ http(s)",
      "pattern": "^https?://"
     },
     "publisher": {
      "type": "string"
     },
     "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     }
    }
   },
   "minItems": 1
  }
 }
}
