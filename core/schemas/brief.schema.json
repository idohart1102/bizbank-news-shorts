{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "brief",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "pillar",
  "format",
  "story_ids",
  "angle",
  "hook",
  "points",
  "action",
  "template",
  "sources"
 ],
 "properties": {
  "kind": {
   "type": "string",
   "enum": [
    "news",
    "knowledge"
   ],
   "description": "hướng nội dung: news = tin tức (1.1), knowledge = kiến thức (1.2, giai đoạn 2)"
  },
  "pillar": {
   "type": "string",
   "enum": [
    "von",
    "quan-tri",
    "luat",
    "ai-marketing"
   ],
   "description": "chủ đề kênh (config/pillars.yaml)"
  },
  "format": {
   "type": "string",
   "enum": [
    "deep",
    "digest",
    "steps",
    "mistakes",
    "explainer"
   ],
   "description": "news: deep (1 tin sâu) | digest (3–4 tin); knowledge: steps (các bước) | mistakes (sai lầm hay gặp) | explainer (giải thích một khái niệm/quy định)"
  },
  "story_ids": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1,
   "maxItems": 4
  },
  "angle": {
   "type": "string",
   "description": "góc nhìn: ảnh hưởng gì tới túi tiền chủ shop"
  },
  "hook": {
   "type": "string"
  },
  "points": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 2,
   "maxItems": 4
  },
  "action": {
   "type": "string",
   "description": "chủ shop cần làm gì ngay"
  },
  "template": {
   "type": "string",
   "description": "tên mẫu overlay, mặc định default"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "url",
     "publisher",
     "tier"
    ],
    "properties": {
     "url": {
      "type": "string",
      "description": "URL đầy đủ http(s)",
      "pattern": "^https?://"
     },
     "publisher": {
      "type": "string"
     },
     "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     }
    }
   },
   "minItems": 1
  },
  "partner": {
   "type": [
    "string",
    "null"
   ],
   "description": "tên đối tác nếu video giới thiệu sản phẩm/dịch vụ của đối tác; null nếu không. Có đối tác thì phải được duyệt trước khi đăng"
  }
 }
}
