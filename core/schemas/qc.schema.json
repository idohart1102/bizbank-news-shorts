{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "qc",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "pass",
  "issues"
 ],
 "properties": {
  "pass": {
   "type": "boolean"
  },
  "issues": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "time",
     "severity",
     "kind",
     "problem",
     "fix"
    ],
    "properties": {
     "time": {
      "type": "number"
     },
     "severity": {
      "type": "string",
      "enum": [
       "major",
       "minor"
      ]
     },
     "kind": {
      "type": "string",
      "enum": [
       "background",
       "card",
       "cutout",
       "cta",
       "frame",
       "ai_realism",
       "other"
      ],
      "description": "background: ảnh nền lạc đề/ngược nghĩa với lời; card: thẻ chữ/số; cutout; cta: cảnh kêu gọi trống; frame: khung đen/lỗi; ai_realism: ảnh AI giống ảnh thật"
     },
     "problem": {
      "type": "string"
     },
     "fix": {
      "type": "string",
      "description": "sửa cụ thể trong edit_plan.json"
     }
    }
   }
  }
 }
}
