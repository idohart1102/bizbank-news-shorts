{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "meta",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "title",
  "description",
  "hashtags",
  "sources"
 ],
 "properties": {
  "title": {
   "type": "string",
   "maxLength": 60
  },
  "description": {
   "type": "string"
  },
  "hashtags": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 3,
   "maxItems": 8
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "publisher",
     "url"
    ],
    "properties": {
     "publisher": {
      "type": "string"
     },
     "url": {
      "type": "string",
      "description": "URL đầy đủ http(s)",
      "pattern": "^https?://"
     }
    }
   },
   "minItems": 1
  }
 }
}
