VBEE_BASE_URL = os.environ.get("VBEE_BASE_URL", "https://api.vbee.vn").rstrip("/")
VBEE_VOICES_URL = os.environ.get("VBEE_VOICES_URL", "https://vbee.vn/api/public/v1/voices")
# Batch API của Vbee bắt buộc có webhookUrl nhưng dịch vụ chỉ nghe ở 127.0.0.1, nên kết quả
# được lấy bằng cách hỏi Get Request. Tên miền .invalid không bao giờ phân giải được, nên
# Vbee không gửi được kết quả (gồm link audio) tới bên thứ ba.
