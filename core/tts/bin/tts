HTTP_TIMEOUT = float(os.environ.get("TTS_HTTP_TIMEOUT", "60"))
MAX_CHARS = int(os.environ.get("TTS_MAX_CHARS", "100000"))
WORKERS = 8
KEYCHAIN_SERVICE = os.environ.get("TTS_KEYCHAIN_SERVICE", "bizbank-news-tts-kingcong")
KEYCHAIN_ACCOUNT = "api-key"
