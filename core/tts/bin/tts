        if line and not line.startswith('#') and '=' in line:
            key, value = line.split('=', 1)
            os.environ.setdefault(key.strip(), value.strip().strip('"').strip("'"))
BASE_URL = os.environ.get("KINGCONG_BASE_URL", "https://api.kingcongstudio.com").rstrip("/")
