# Bí mật của máy này (chép thành .env, KHÔNG vào Git).
# 9router: bỏ trống thì đọc key đang bật trong ~/.9router/db/data.sqlite
NINEROUTER_API_KEY=
NINEROUTER_KEY_NAME=
# Key Vbee được cấu hình ở dịch vụ platform/tts, không đặt trong repo video.
# Telegram (khi bật notify.telegram.enabled trong config/channel.yaml):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
